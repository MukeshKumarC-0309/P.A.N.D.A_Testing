# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

# PandaVault uses an embedded SQLite database, so no DB host/user/password
# is needed. The vault is a local file at ~/.pandavault/vault.db by default.
# Uncomment to override that location (e.g. for testing):
# PANDA_DB_PATH=/absolute/path/to/vault.db

PANDA_WEATHER_API_KEY=your_openweathermap_api_key_here
PANDA_NEWS_API_KEY=your_newsapi_org_key_here
